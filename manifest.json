{
  "manifest_version": 3,
  "name": "One Shortcut for AI Chat",
  "short_name": "One Shortcut",
  "version": "1.3.1",
  "description": "Send one prompt to new chats across six AI assistants, with unified new-chat and chat-search shortcuts.",
  "homepage_url": "https://github.com/algorirhy/one-ai-shortcut",
  "permissions": ["tabs", "notifications"],
  "commands": {
    "new-chat": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Start a new chat on the current supported AI site"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.doubao.com/*",
        "https://doubao.com/*"
      ],
      "js": ["doubao-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*",
        "https://www.deepseek.com/*",
        "https://www.doubao.com/*",
        "https://doubao.com/*"
      ],
      "js": ["sites.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
