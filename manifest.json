{
  "manifest_version": 3,
  "name": "One Shortcut for AI Chat",
  "version": "1.1.1",
  "description": "Send one prompt to new chats across six AI assistants, with unified new-chat and chat-search shortcuts.",
  "permissions": ["tabs"],
  "commands": {
    "new-chat": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Start a new chat across supported AI assistants"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*",
        "https://www.deepseek.com/*",
        "https://www.doubao.com/*",
        "https://doubao.com/*"
      ],
      "js": ["sites.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
